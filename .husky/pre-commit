# Husky already invokes this with `sh -e`, but stating it here means the hook still stops at
# the first failure when it is run directly — which is how you debug it.
set -e

# Autofix and re-stage only what is actually being committed. Anything eslint cannot fix
# on its own fails here, so a broken lint never reaches a commit.
npx lint-staged

# Whole-project checks, in ascending order of cost. They are not in `lint-staged.config.js`
# because lint-staged would append the staged filenames to them; see the note in that file.
npm run typecheck
npm run test:unit

# The `nuxt` and `e2e` projects are deliberately absent: between them they build the app
# and boot a server, which is minutes rather than seconds. Run `npm test` before pushing.
#
# To bypass this hook once: `git commit --no-verify`, or `HUSKY=0 git commit`.
